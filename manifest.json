{
  "manifest_version": 3,
  "name": "Random Game Generator",
  "version": "0.1.0",
  "description": "Tu backlog gamer, organizado. Filtra tu biblioteca y deja que la suerte decida qué juegas hoy.",
  "default_locale": "es",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "unlimitedStorage", "contextMenus"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Random Game Generator",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "src/dashboard/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
